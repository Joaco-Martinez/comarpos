import crypto from "crypto";

function getSecretKey() {
  const secret = process.env.ARCA_CREDENTIALS_SECRET || process.env.AFIP_CREDENTIALS_SECRET;
  if (!secret || secret.length < 32) {
    throw new Error("Falta ARCA_CREDENTIALS_SECRET o debe tener al menos 32 caracteres.");
  }

  return crypto.createHash("sha256").update(secret).digest();
}

export const arcaCryptoService = {
  encrypt(plainText: string) {
    const iv = crypto.randomBytes(12);
    const cipher = crypto.createCipheriv("aes-256-gcm", getSecretKey(), iv);
    const encrypted = Buffer.concat([cipher.update(plainText, "utf8"), cipher.final()]);
    const tag = cipher.getAuthTag();

    return [iv.toString("base64"), tag.toString("base64"), encrypted.toString("base64")].join(":");
  },

  decrypt(payload: string) {
    const [ivRaw, tagRaw, encryptedRaw] = payload.split(":");
    if (!ivRaw || !tagRaw || !encryptedRaw) {
      throw new Error("Credencial ARCA cifrada inválida.");
    }

    const decipher = crypto.createDecipheriv("aes-256-gcm", getSecretKey(), Buffer.from(ivRaw, "base64"));
    decipher.setAuthTag(Buffer.from(tagRaw, "base64"));

    return Buffer.concat([
      decipher.update(Buffer.from(encryptedRaw, "base64")),
      decipher.final(),
    ]).toString("utf8");
  },
};
